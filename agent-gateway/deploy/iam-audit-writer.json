{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "WriteAuditObjectsOnly", "Effect": "Allow",
     "Action": ["s3:PutObject", "s3:PutObjectRetention", "s3:GetObject", "s3:ListBucket"],
     "Resource": ["arn:aws:s3:::REPLACE-audit-bucket", "arn:aws:s3:::REPLACE-audit-bucket/audit/*"]},
    {"Sid": "NeverDeleteOrWeakenRetention", "Effect": "Deny",
     "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:BypassGovernanceRetention",
                "s3:PutBucketObjectLockConfiguration", "s3:PutBucketVersioning", "s3:DeleteBucket",
                "s3:PutLifecycleConfiguration"],
     "Resource": ["arn:aws:s3:::REPLACE-audit-bucket", "arn:aws:s3:::REPLACE-audit-bucket/*"]}
  ]
}
